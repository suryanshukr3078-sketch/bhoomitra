{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "path"
        }
      ],
      "destination": "/api/index.py"
    }
  ]
}
