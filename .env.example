# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=land_governance
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Backend API Configuration
ENVIRONMENT=development
PROJECT_NAME="Land Governance Platform"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database URL
# PostgreSQL (default with local Docker):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/land_governance
# Supabase Pooler (Transaction Mode, port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[PASSWORD]@[pooler-host]:6543/postgres
# SQLite Fallback (if running without Docker):
# DATABASE_URL=sqlite:///./land_governance.db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SMTP Email Configuration (e.g. Gmail SMTP or custom relays)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Bhoomitra Land Governance Platform"
SMTP_TLS=true
SMTP_SSL=false
