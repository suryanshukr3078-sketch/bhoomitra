# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=6543
POSTGRES_HOST=aws-0-[region].pooler.supabase.com

# Backend API Configuration
ENVIRONMENT=development
PROJECT_NAME="Land Governance Platform"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database URL
# Local PostgreSQL (Docker):
# DATABASE_URL=postgresql+psycopg://land_admin:land_admin@127.0.0.1:5432/land_governance
# Supabase Pooler (Transaction Mode, port 6543):
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[PASSWORD]@[pooler-host]:6543/postgres

# Redis Cache URL
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO / S3 Configuration
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_admin_secret
S3_BUCKET_NAME=land-governance-documents

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SMTP Email Configuration (e.g. Gmail SMTP or custom relays)
# For Gmail: Use smtp.gmail.com with a 16-character Google App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Bhoomitra Land Governance Platform"
SMTP_TLS=true
SMTP_SSL=false
